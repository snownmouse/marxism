[
  { "id": "prim_hunter_1", "stageId": 0, "classType": "commoner", "text": "今天的浆果真多！", "glossaryId": "primitive_community", "chatType": "educational" },
  { "id": "prim_hunter_2", "stageId": 0, "classType": "commoner", "text": "大家一起去打猎吧！", "glossaryId": "collective_labor", "chatType": "educational" },
  { "id": "prim_elder_1", "stageId": 0, "classType": "commoner", "text": "火是大家的，不能独占。", "glossaryId": "primitive_community", "chatType": "educational" },
  { "id": "prim_elder_2", "stageId": 0, "classType": "commoner", "text": "山洞属于每一个人。", "glossaryId": "public_ownership", "chatType": "educational" },
  { "id": "prim_gatherer_1", "stageId": 0, "classType": "commoner", "text": "果实要分给所有人。", "glossaryId": "collective_labor", "chatType": "educational" },
  { "id": "prim_shaman_1", "stageId": 0, "classType": "commoner", "text": "图腾指引我们，万物皆有灵。", "glossaryId": "consciousness", "chatType": "educational" },
  { "id": "prim_hunter_3", "stageId": 0, "classType": "commoner", "text": "今晚的猎物够全族吃三天！", "glossaryId": "collective_labor", "chatType": "educational" },
  { "id": "prim_child_1", "stageId": 0, "classType": "commoner", "text": "妈妈说大家的食物都是一样的。", "glossaryId": "primitive_community", "chatType": "educational" },
  { "id": "prim_craftsman_1", "stageId": 0, "classType": "commoner", "text": "这块石头是我打磨的——它是我们最早的工具。", "glossaryId": "productive_forces", "chatType": "educational" },
  { "id": "prim_thinker_1", "stageId": 0, "classType": "commoner", "text": "打雷的时候我们害怕，因为我们不理解它。", "glossaryId": "practice_and_cognition", "chatType": "educational" },
  { "id": "prim_thinker_2", "stageId": 0, "classType": "commoner", "text": "我是猎人你是采集者——但我们都是人。", "glossaryId": "human_essence", "chatType": "educational" },
  { "id": "prim_cause_1", "stageId": 0, "classType": "commoner", "text": "昨天篝火烧得太旺，林里的鹿全跑了——你看，一件小事能引出大后果！", "glossaryId": "cause_effect", "chatType": "educational" },
  { "id": "prim_essence_1", "stageId": 0, "classType": "commoner", "text": "打雷不是天上有人在吼——那是云撞在一起放出的火光，看着吓人，背后有道理！", "glossaryId": "essence_appearance", "chatType": "educational" },
  { "id": "prim_necessity_1", "stageId": 0, "classType": "commoner", "text": "年年冬天都有老人熬不过去——我不觉得这是命，是食物不够，多存些就能活。", "glossaryId": "necessity_contingency", "chatType": "educational" },
  { "id": "prim_knowledge_1", "stageId": 0, "classType": "commoner", "text": "我知道火能烧人——这是我亲眼见的。但为什么火能烧人？我想了三天才明白。", "glossaryId": "perceptual_rational_knowledge", "chatType": "educational" },
  { "id": "prim_chat_1", "stageId": 0, "classType": "commoner", "text": "今天天气真好，适合出去走走！", "glossaryId": "", "chatType": "chatter" },
  { "id": "prim_chat_2", "stageId": 0, "classType": "commoner", "text": "你看我这块石头，磨得多尖？", "glossaryId": "", "chatType": "chatter" },
  { "id": "prim_chat_3", "stageId": 0, "classType": "commoner", "text": "昨晚我梦见一只大鹿，跑得飞快。", "glossaryId": "", "chatType": "chatter" },
  { "id": "prim_chat_4", "stageId": 0, "classType": "commoner", "text": "你说天上那个发光的东西到底是什么？", "glossaryId": "", "chatType": "chatter" },
  { "id": "prim_chat_5", "stageId": 0, "classType": "commoner", "text": "吃饱了就想睡觉……呼……", "glossaryId": "", "chatType": "chatter" },
  { "id": "prim_chat_6", "stageId": 0, "classType": "commoner", "text": "你昨天采的蘑菇好吃吗？在哪找到的？", "glossaryId": "", "chatType": "chatter" },
  { "id": "prim_chat_7", "stageId": 0, "classType": "commoner", "text": "嘿！走慢点，等等我！", "glossaryId": "", "chatType": "chatter" },
  { "id": "prim_quirky_1", "stageId": 0, "classType": "commoner", "text": "我觉得山洞深处有人在偷看我，但我回头又什么都没有。", "glossaryId": "", "chatType": "quirky" },
  { "id": "prim_quirky_2", "stageId": 0, "classType": "commoner", "text": "这块石头昨天还在那边，今天自己跑这边来了——它肯定是活的。", "glossaryId": "", "chatType": "quirky" },
  { "id": "prim_quirky_3", "stageId": 0, "classType": "commoner", "text": "我昨晚跟月亮说话了，它还回我了，你们都没听见吗？", "glossaryId": "", "chatType": "quirky" },
  { "id": "prim_quirky_4", "stageId": 0, "classType": "commoner", "text": "你有没有觉得火在看着我们？你看它一跳一跳的，像在跳舞……", "glossaryId": "", "chatType": "quirky" },

  { "id": "priv_noble_1", "stageId": 1, "classType": "noble", "text": "这些粮食是我家的，不是公家的！", "glossaryId": "private_property", "chatType": "educational" },
  { "id": "priv_freeman_1", "stageId": 1, "classType": "commoner", "text": "我打猎的工具归我自己了。", "glossaryId": "private_property", "chatType": "educational" },
  { "id": "priv_freeman_2", "stageId": 1, "classType": "commoner", "text": "多余的粮食可以换东西了。", "glossaryId": "surplus_product", "chatType": "educational" },
  { "id": "priv_captive_1", "stageId": 1, "classType": "slave", "text": "我不再是自由人了……", "glossaryId": "class", "chatType": "educational" },
  { "id": "priv_noble_2", "stageId": 1, "classType": "noble", "text": "我家三代都是首领，这个位置该我继承。", "glossaryId": "class", "chatType": "educational" },
  { "id": "priv_trader_1", "stageId": 1, "classType": "commoner", "text": "我用粮换你的工具，各取所需。", "glossaryId": "surplus_product", "chatType": "educational" },
  { "id": "priv_noble_3", "stageId": 1, "classType": "noble", "text": "打败了邻族，他们的东西现在归我了。", "glossaryId": "private_property", "chatType": "educational" },
  { "id": "priv_rebel_1", "stageId": 1, "classType": "commoner", "text": "以前大家一样穷，现在有人开始不一样了。", "glossaryId": "contradiction", "chatType": "educational" },
  { "id": "priv_thinker_1", "stageId": 1, "classType": "noble", "text": "我的想法跟着我的东西变了——东西多了，想法也变了。", "glossaryId": "social_being", "chatType": "educational" },
  { "id": "priv_elder_1", "stageId": 1, "classType": "noble", "text": "一点点变化堆起来，最后什么都变了。", "glossaryId": "quantity_to_quality", "chatType": "educational" },
  { "id": "priv_contradiction_1", "stageId": 1, "classType": "commoner", "text": "你说私有不好——可你看邻族也在搞私有！每个地方都有争东西的麻烦，但每个地方的麻烦不一样！", "glossaryId": "contradiction_universality_particularity", "chatType": "educational" },
  { "id": "priv_principal_1", "stageId": 1, "classType": "noble", "text": "那么多问题——围栏该归谁、猎场怎么分、战俘怎么办——归根到底就一个问题：东西归谁。", "glossaryId": "principal_secondary_contradiction", "chatType": "educational" },
  { "id": "priv_initiative_1", "stageId": 1, "classType": "commoner", "text": "不能光等着天上掉果子！我带人挖了水渠、开了一片新田——人不是只能等自然的。", "glossaryId": "subjective_initiative", "chatType": "educational" },
  { "id": "priv_chat_1", "stageId": 1, "classType": "commoner", "text": "我家今年收成比去年好！你呢？", "glossaryId": "", "chatType": "chatter" },
  { "id": "priv_chat_2", "stageId": 1, "classType": "commoner", "text": "听说隔壁家的围栏又扩建了……", "glossaryId": "", "chatType": "chatter" },
  { "id": "priv_chat_3", "stageId": 1, "classType": "noble", "text": "这些地界的事，改天再好好说说。", "glossaryId": "", "chatType": "chatter" },
  { "id": "priv_chat_4", "stageId": 1, "classType": "commoner", "text": "有人拿贝壳换粮食！你说怪不怪？", "glossaryId": "", "chatType": "chatter" },
  { "id": "priv_chat_5", "stageId": 1, "classType": "commoner", "text": "我开始觉得，好东西应该留给自己。", "glossaryId": "", "chatType": "chatter" },
  { "id": "priv_chat_6", "stageId": 1, "classType": "commoner", "text": "你昨天换来的那个陶罐挺好看。", "glossaryId": "", "chatType": "chatter" },
  { "id": "priv_quirky_1", "stageId": 1, "classType": "commoner", "text": "你有没有发现，围栏的木桩晚上会自己换位置？我数过了，白天八个晚上九个。", "glossaryId": "", "chatType": "quirky" },
  { "id": "priv_quirky_2", "stageId": 1, "classType": "commoner", "text": "我觉得田里的麦子在说我坏话，风一吹它们就沙沙沙……", "glossaryId": "", "chatType": "quirky" },
  { "id": "priv_quirky_3", "stageId": 1, "classType": "commoner", "text": "昨天有条鱼跟我说话了，它说水里挺好的就是有点冷。", "glossaryId": "", "chatType": "quirky" },

  { "id": "slave_master_1", "stageId": 2, "classType": "noble", "text": "奴隶就是会说话的工具。", "glossaryId": "slavery", "chatType": "educational" },
  { "id": "slave_master_2", "stageId": 2, "classType": "noble", "text": "我的宫殿要更大！多征些奴隶！", "glossaryId": "exploitation", "chatType": "educational" },
  { "id": "slave_slave_1", "stageId": 2, "classType": "slave", "text": "整天干活，连饭都吃不饱。", "glossaryId": "surplus_value", "chatType": "educational" },
  { "id": "slave_slave_2", "stageId": 2, "classType": "slave", "text": "我什么都不是，连命都不是自己的。", "glossaryId": "slavery", "chatType": "educational" },
  { "id": "slave_freeman_1", "stageId": 2, "classType": "commoner", "text": "还好我是自由民……但日子也不好过。", "glossaryId": "class", "chatType": "educational" },
  { "id": "slave_scribe_1", "stageId": 2, "classType": "noble", "text": "读书写字是贵族的特权。", "glossaryId": "mental_manual_divide", "chatType": "educational" },
  { "id": "slave_rebel_1", "stageId": 2, "classType": "slave", "text": "再不反抗我们就永远做牛做马了。", "glossaryId": "class_struggle", "chatType": "educational" },
  { "id": "slave_priest_1", "stageId": 2, "classType": "noble", "text": "多修几座神庙，让奴隶相信这是天命。", "glossaryId": "ideology", "chatType": "educational" },
  { "id": "slave_thinker_1", "stageId": 2, "classType": "noble", "text": "为什么要有国家？因为没国家打来打去谁都活不了。", "glossaryId": "state_origin", "chatType": "educational" },
  { "id": "slave_thinker_2", "stageId": 2, "classType": "commoner", "text": "有人什么都有，有人什么都没有——两边没法和平。", "glossaryId": "contradiction", "chatType": "educational" },
  { "id": "slave_philosopher_1", "stageId": 2, "classType": "noble", "text": "世间一切都分成两边：自由和不自由、富和穷。", "glossaryId": "dialectics", "chatType": "educational" },
  { "id": "slave_content_1", "stageId": 2, "classType": "noble", "text": "我们把国家叫'民主'——但看里面：一小撮人发号施令，一大群人当牛做马。名字好听，里子没变！", "glossaryId": "content_form", "chatType": "educational" },
  { "id": "slave_individual_1", "stageId": 2, "classType": "commoner", "text": "斯巴达克斯闹了一场，奴隶还是奴隶——他能加速或拖慢，但改不了大势。", "glossaryId": "individual_in_history", "chatType": "educational" },
  { "id": "slave_possibility_1", "stageId": 2, "classType": "slave", "text": "你说不可能推翻主人？可我先祖就是自由的——既然以前自由过，以后也能自由！可能这东西，不试怎么知道？", "glossaryId": "possibility_actuality", "chatType": "educational" },
  { "id": "slave_chat_1", "stageId": 2, "classType": "commoner", "text": "听说城里的贵族又建了新宫殿，真有钱啊。", "glossaryId": "", "chatType": "chatter" },
  { "id": "slave_chat_2", "stageId": 2, "classType": "noble", "text": "这葡萄酒不错，再给我倒一杯。", "glossaryId": "", "chatType": "chatter" },
  { "id": "slave_chat_3", "stageId": 2, "classType": "commoner", "text": "今天太阳真毒，腰都直不起来了。", "glossaryId": "", "chatType": "chatter" },
  { "id": "slave_chat_4", "stageId": 2, "classType": "slave", "text": "昨晚我梦见我自由了……就是一场梦。", "glossaryId": "", "chatType": "chatter" },
  { "id": "slave_chat_5", "stageId": 2, "classType": "noble", "text": "今天的集市听说来了远方商人。", "glossaryId": "", "chatType": "chatter" },
  { "id": "slave_quirky_1", "stageId": 2, "classType": "slave", "text": "有时候我觉得这镣铐是活的——它在咬我，真的，有牙齿。", "glossaryId": "", "chatType": "quirky" },
  { "id": "slave_quirky_2", "stageId": 2, "classType": "commoner", "text": "昨天我在井边看见一个长得跟我一模一样的人，但他在笑，我没笑。", "glossaryId": "", "chatType": "quirky" },
  { "id": "slave_quirky_3", "stageId": 2, "classType": "noble", "text": "我养的那只孔雀昨天开口说人话了——它说我太胖了。", "glossaryId": "", "chatType": "quirky" },

  { "id": "feudal_lord_1", "stageId": 3, "classType": "noble", "text": "这片土地是我的，你们要交租！", "glossaryId": "feudalism", "chatType": "educational" },
  { "id": "feudal_lord_2", "stageId": 3, "classType": "noble", "text": "君权神授，我的权力来自天命！", "glossaryId": "ideology", "chatType": "educational" },
  { "id": "feudal_serf_1", "stageId": 3, "classType": "commoner", "text": "交完地租，只剩糠麸了。", "glossaryId": "serfdom", "chatType": "educational" },
  { "id": "feudal_serf_2", "stageId": 3, "classType": "commoner", "text": "想去城里？领主不让我走。", "glossaryId": "serfdom", "chatType": "educational" },
  { "id": "feudal_artisan_1", "stageId": 3, "classType": "commoner", "text": "行会规矩多，但好歹有口饭吃。", "glossaryId": "social_division", "chatType": "educational" },
  { "id": "feudal_priest_1", "stageId": 3, "classType": "noble", "text": "今世的苦难是来世的考验，忍耐吧。", "glossaryId": "ideology", "chatType": "educational" },
  { "id": "feudal_peasant_1", "stageId": 3, "classType": "commoner", "text": "什么天命！不过是骗我们交租的把戏。", "glossaryId": "class_consciousness", "chatType": "educational" },
  { "id": "feudal_lord_3", "stageId": 3, "classType": "noble", "text": "地是我的，水是我的，你也是我的佃户。", "glossaryId": "land_rent", "chatType": "educational" },
  { "id": "feudal_doubter_1", "stageId": 3, "classType": "commoner", "text": "教堂说服从领主是天命——可天命是谁定的？", "glossaryId": "base_and_superstructure", "chatType": "educational" },
  { "id": "feudal_thinker_1", "stageId": 3, "classType": "commoner", "text": "以前是奴隶制，后来废除了——但领主和奴隶主像不像？", "glossaryId": "negation_of_negation", "chatType": "educational" },
  { "id": "feudal_law_1", "stageId": 3, "classType": "commoner", "text": "领主说地是他的——可地自己不会说话！不管他认不认，种地的人多了工具好了，这制度就得变——这是铁打的规矩！", "glossaryId": "law_objectivity", "chatType": "educational" },
  { "id": "feudal_masses_1", "stageId": 3, "classType": "commoner", "text": "这座城堡谁建的？这些田谁开的？不是国王，不是领主——是我们！可书上从来不写我们。", "glossaryId": "masses_create_history", "chatType": "educational" },
  { "id": "feudal_truth_1", "stageId": 3, "classType": "noble", "text": "神父说地球是宇宙中心——也许有一天后人会说这可笑。真理不是死的，它是一步步走近的。", "glossaryId": "truth_absoluteness_relativity", "chatType": "educational" },
  { "id": "feudal_chat_1", "stageId": 3, "classType": "commoner", "text": "今年的收成还行，就是税太重了。", "glossaryId": "", "chatType": "chatter" },
  { "id": "feudal_chat_2", "stageId": 3, "classType": "commoner", "text": "你听说了吗？隔壁村有人逃到城里去了。", "glossaryId": "", "chatType": "chatter" },
  { "id": "feudal_chat_3", "stageId": 3, "classType": "noble", "text": "今天的晚宴有烤乳猪，可别迟到了。", "glossaryId": "", "chatType": "chatter" },
  { "id": "feudal_chat_4", "stageId": 3, "classType": "commoner", "text": "这天气，明天该下雨了吧。", "glossaryId": "", "chatType": "chatter" },
  { "id": "feudal_chat_5", "stageId": 3, "classType": "commoner", "text": "我家孩子昨天学会了数数，真聪明！", "glossaryId": "", "chatType": "chatter" },
  { "id": "feudal_quirky_1", "stageId": 3, "classType": "commoner", "text": "教堂的钟昨晚自己响了十二下，但敲钟人说他根本没去——怪事！", "glossaryId": "", "chatType": "quirky" },
  { "id": "feudal_quirky_2", "stageId": 3, "classType": "commoner", "text": "我觉得我养的牛认识我——真的，它看我的眼神跟看别人不一样。", "glossaryId": "", "chatType": "quirky" },
  { "id": "feudal_quirky_3", "stageId": 3, "classType": "noble", "text": "我昨晚梦见我的城堡在天上飞——它说它累了，想下来走走。", "glossaryId": "", "chatType": "quirky" },

  { "id": "cap_capitalist_1", "stageId": 4, "classType": "capitalist", "text": "效率就是生命！", "glossaryId": "capital_accumulation", "chatType": "educational" },
  { "id": "cap_capitalist_2", "stageId": 4, "classType": "capitalist", "text": "投资扩大生产，利润翻倍！", "glossaryId": "surplus_value", "chatType": "educational" },
  { "id": "cap_worker_1", "stageId": 4, "classType": "worker", "text": "每天干12小时，只能买黑面包。", "glossaryId": "labor_power", "chatType": "educational" },
  { "id": "cap_worker_2", "stageId": 4, "classType": "worker", "text": "工资刚发就交了房租。", "glossaryId": "surplus_value", "chatType": "educational" },
  { "id": "cap_merchant_1", "stageId": 4, "classType": "commoner", "text": "只要努力，我也能当老板。", "glossaryId": "commodity_fetishism", "chatType": "educational" },
  { "id": "cap_worker_3", "stageId": 4, "classType": "worker", "text": "机器越来越快，我跟不上了。", "glossaryId": "alienation", "chatType": "educational" },
  { "id": "cap_worker_4", "stageId": 4, "classType": "worker", "text": "工厂的布堆成山，我们却穿不起。", "glossaryId": "economic_crisis", "chatType": "educational" },
  { "id": "cap_banker_1", "stageId": 4, "classType": "capitalist", "text": "借我的钱开工厂，利息九出十三归。", "glossaryId": "capital_accumulation", "chatType": "educational" },
  { "id": "cap_engineer_1", "stageId": 4, "classType": "worker", "text": "这台机器转起来顶一百个人——这就是生产力的革命。", "glossaryId": "productive_forces", "chatType": "educational" },
  { "id": "cap_thinker_1", "stageId": 4, "classType": "worker", "text": "老板跟工人——这就是新的生产关系，它跟我们以前看到的所有关系都不一样。", "glossaryId": "relations_of_production", "chatType": "educational" },
  { "id": "cap_peasant_1", "stageId": 4, "classType": "worker", "text": "圈地那会儿一夜之间我们就没了地——这就叫原始积累。", "glossaryId": "primitive_accumulation", "chatType": "educational" },
  { "id": "cap_banker_2", "stageId": 4, "classType": "capitalist", "text": "机器越来越多，利润反而越来越薄——这是资本的宿命。", "glossaryId": "falling_profit_rate", "chatType": "educational" },
  { "id": "cap_labor_duality_1", "stageId": 4, "classType": "worker", "text": "我做椅子——锯木头、钉钉子，这手艺活谁都看得见。可我这身力气花出去，又该怎么算？", "glossaryId": "labor_duality", "chatType": "educational" },
  { "id": "cap_value_law_1", "stageId": 4, "classType": "commoner", "text": "今天面包三文钱，明天五文——上上下下，可你看三个月，它总围着个中间值转。背后有条看不见的线！", "glossaryId": "law_of_value", "chatType": "educational" },
  { "id": "cap_money_1", "stageId": 4, "classType": "capitalist", "text": "金子就是金子，暖不了手、填不饱肚——可为什么所有人拿东西换它？因为人心认它！这不是金子在说话，是人在通过金子说话。", "glossaryId": "money_essence", "chatType": "educational" },
  { "id": "cap_surplus_rate_1", "stageId": 4, "classType": "worker", "text": "我一天做出值一百的货，老板给我四十——剩下六十哪儿去了？那六十就是我的血汗凝成的，被人白白拿走了！", "glossaryId": "rate_of_surplus_value", "chatType": "educational" },
  { "id": "cap_wage_1", "stageId": 4, "classType": "worker", "text": "老板说给我工钱是'买我的劳动'——可我掰手指算：我一天干十二个钟头，做出来的东西比他给我的多得多！他是买了我的力气，不是买了我的活！", "glossaryId": "wage_essence", "chatType": "educational" },
  { "id": "cap_profit_1", "stageId": 4, "classType": "capitalist", "text": "织布赚得太少——我把钱转到铁路上，那边赚得多。可说来也怪，去的人一多，铁路的利润也下来了。", "glossaryId": "average_profit", "chatType": "educational" },
  { "id": "cap_motion_1", "stageId": 4, "classType": "worker", "text": "你看这台蒸汽机——活塞一上一下没停过，不动的机器就是一堆废铁。人、社会、世界，没什么是停着的。", "glossaryId": "matter_motion", "chatType": "educational" },
  { "id": "cap_chat_1", "stageId": 4, "classType": "worker", "text": "今天下班去喝一杯？", "glossaryId": "", "chatType": "chatter" },
  { "id": "cap_chat_2", "stageId": 4, "classType": "worker", "text": "听说隔壁厂又裁人了，这日子什么时候是个头。", "glossaryId": "", "chatType": "chatter" },
  { "id": "cap_chat_3", "stageId": 4, "classType": "capitalist", "text": "最近股市波动挺大，你关注了吗？", "glossaryId": "", "chatType": "chatter" },
  { "id": "cap_chat_4", "stageId": 4, "classType": "commoner", "text": "报纸上说今年经济形势不错，可我怎么觉得东西越来越贵了。", "glossaryId": "", "chatType": "chatter" },
  { "id": "cap_chat_5", "stageId": 4, "classType": "worker", "text": "机器又坏了，修了一上午。", "glossaryId": "", "chatType": "chatter" },
  { "id": "cap_chat_6", "stageId": 4, "classType": "commoner", "text": "你说人到底是为了什么活着呢？", "glossaryId": "", "chatType": "chatter" },
  { "id": "cap_quirky_1", "stageId": 4, "classType": "worker", "text": "我总觉得工厂那台蒸汽机认识我——今天它喷气的节奏跟昨天不一样，肯定是心情不好。", "glossaryId": "", "chatType": "quirky" },
  { "id": "cap_quirky_2", "stageId": 4, "classType": "commoner", "text": "你有没有发现，所有的钟都在骗我们？我盯着钟看了五分钟，它明明停了，然后又跳了五分钟。", "glossaryId": "", "chatType": "quirky" },
  { "id": "cap_quirky_3", "stageId": 4, "classType": "worker", "text": "昨晚我梦见自己在流水线上组装自己——醒来一身冷汗。", "glossaryId": "", "chatType": "quirky" },

  { "id": "mono_banker_1", "stageId": 5, "classType": "capitalist", "text": "合并工厂，抬高价格。", "glossaryId": "monopoly", "chatType": "educational" },
  { "id": "mono_banker_2", "stageId": 5, "classType": "capitalist", "text": "小企业？让他们破产好了。", "glossaryId": "monopoly", "chatType": "educational" },
  { "id": "mono_unemployed_1", "stageId": 5, "classType": "worker", "text": "厂子关了，孩子饿得哭。", "glossaryId": "overproduction", "chatType": "educational" },
  { "id": "mono_striker_1", "stageId": 5, "classType": "worker", "text": "团结起来，增加工资！", "glossaryId": "class_struggle", "chatType": "educational" },
  { "id": "mono_worker_1", "stageId": 5, "classType": "worker", "text": "流水线越来越快，人快撑不住了。", "glossaryId": "exploitation", "chatType": "educational" },
  { "id": "mono_general_1", "stageId": 5, "classType": "capitalist", "text": "为了打开市场，政府派我们去打仗。", "glossaryId": "imperialism", "chatType": "educational" },
  { "id": "mono_intellectual_1", "stageId": 5, "classType": "worker", "text": "工人不能只满足于加薪，要改变制度！", "glossaryId": "trade_unionism", "chatType": "educational" },
  { "id": "mono_worker_2", "stageId": 5, "classType": "worker", "text": "全世界受苦的人都一样，联合起来！", "glossaryId": "proletarian_internationalism", "chatType": "educational" },
  { "id": "mono_thinker_1", "stageId": 5, "classType": "worker", "text": "回头看这五个阶段——不是谁设计的，是它自己这么发展的。", "glossaryId": "historical_materialism", "chatType": "educational" },
  { "id": "mono_theorist_1", "stageId": 5, "classType": "worker", "text": "马克思不是瞎想的——他看透了资本怎么动、往哪儿走。", "glossaryId": "scientific_socialism", "chatType": "educational" },
  { "id": "mono_rebel_1", "stageId": 5, "classType": "worker", "text": "不只要加薪——要换一个完全不一样的制度。", "glossaryId": "revolution", "chatType": "educational" },
  { "id": "mono_state_1", "stageId": 5, "classType": "worker", "text": "大街上那些人说国会是为人民——可国会批的法，哪条不是护着大老板的钱袋子？国家跟资本早就是一家了！", "glossaryId": "state_monopoly_capitalism", "chatType": "educational" },
  { "id": "mono_global_1", "stageId": 5, "classType": "capitalist", "text": "我们的棉花从印度来，布卖到非洲去——现在不是一地一国的事了，全世界的工厂都在抢饭，全世界的工人都在受苦。", "glossaryId": "economic_globalization", "chatType": "educational" },
  { "id": "mono_change_1", "stageId": 5, "classType": "worker", "text": "现在有社保有假期——可你算过没有？我爷爷做一件货自己能留三成，我现在连一成都不到！表面好看了，骨子里更狠了。", "glossaryId": "contemporary_capitalism_changes", "chatType": "educational" },
  { "id": "mono_chat_1", "stageId": 5, "classType": "worker", "text": "听说隔壁街区又有人上街游行了。", "glossaryId": "", "chatType": "chatter" },
  { "id": "mono_chat_2", "stageId": 5, "classType": "worker", "text": "儿子昨天问我为什么家里没面包，我说不出口。", "glossaryId": "", "chatType": "chatter" },
  { "id": "mono_chat_3", "stageId": 5, "classType": "capitalist", "text": "市场有波动很正常嘛，要有信心。", "glossaryId": "", "chatType": "chatter" },
  { "id": "mono_chat_4", "stageId": 5, "classType": "worker", "text": "你看那边那座楼，亮了一整晚的灯，不知道在干嘛。", "glossaryId": "", "chatType": "chatter" },
  { "id": "mono_quirky_1", "stageId": 5, "classType": "worker", "text": "昨天晚上我看见月亮变成了一个金币掉下来了，但我没接住——醒来发现是梦，枕头上湿了一片。", "glossaryId": "", "chatType": "quirky" },
  { "id": "mono_quirky_2", "stageId": 5, "classType": "capitalist", "text": "说出来你可能不信——我养的猫昨天给我做了一份财务报表，净利那栏它写的是'喵'。", "glossaryId": "", "chatType": "quirky" },
  { "id": "mono_quirky_3", "stageId": 5, "classType": "worker", "text": "你有没有觉得城市是个巨大的机器？我们在它肚子里转，它偶尔打个嗝就是金融危机。", "glossaryId": "", "chatType": "quirky" },

  { "id": "social_farmer_1", "stageId": 6, "classType": "commoner", "text": "土地归公，拖拉机真带劲。", "glossaryId": "public_ownership", "chatType": "educational" },
  { "id": "social_cadre_1", "stageId": 6, "classType": "noble", "text": "按劳分配，不劳动者不得食。", "glossaryId": "distribution_labor", "chatType": "educational" },
  { "id": "social_worker_1", "stageId": 6, "classType": "worker", "text": "现在看病不花钱了。", "glossaryId": "social_security", "chatType": "educational" },
  { "id": "social_intellectual_1", "stageId": 6, "classType": "commoner", "text": "知识不再是少数人的特权。", "glossaryId": "human_development", "chatType": "educational" },
  { "id": "social_doctor_1", "stageId": 6, "classType": "commoner", "text": "人人都能享受医疗服务。", "glossaryId": "social_security", "chatType": "educational" },
  { "id": "social_woman_1", "stageId": 6, "classType": "commoner", "text": "男女同工同酬，妇女顶半边天。", "glossaryId": "human_development", "chatType": "educational" },
  { "id": "social_student_1", "stageId": 6, "classType": "commoner", "text": "上大学不要钱，知识改变命运。", "glossaryId": "social_security", "chatType": "educational" },
  { "id": "social_engineer_1", "stageId": 6, "classType": "worker", "text": "五年计划让工业翻了两番！", "glossaryId": "public_ownership", "chatType": "educational" },
  { "id": "social_leader_1", "stageId": 6, "classType": "noble", "text": "现在是我们工人说了算——这叫无产阶级专政。", "glossaryId": "dictatorship_proletariat", "chatType": "educational" },
  { "id": "social_historian_1", "stageId": 6, "classType": "commoner", "text": "巴黎公社七十二天——但每一项都指向未来。", "glossaryId": "paris_commune", "chatType": "educational" },
  { "id": "social_party_1", "stageId": 6, "classType": "noble", "text": "只靠我们散乱地干不行——得有一个不怕死、看得远、心里只有工人的队伍来领头，这就是我们党。", "glossaryId": "marxist_party", "chatType": "educational" },
  { "id": "social_spread_1", "stageId": 6, "classType": "commoner", "text": "先是那边的人干了，后来这边也干了——不是一地的事，是一阵风刮到哪儿哪儿就亮起来！", "glossaryId": "socialism_one_to_many", "chatType": "educational" },
  { "id": "social_tech_1", "stageId": 6, "classType": "worker", "text": "拖拉机能顶五十个人、发电机照亮整个集体农场——脑袋里的东西变成手上的东西，这就是最大的力量！", "glossaryId": "science_technology_productivity", "chatType": "educational" },
  { "id": "social_chat_1", "stageId": 6, "classType": "commoner", "text": "今天食堂有红烧肉，早点去排队！", "glossaryId": "", "chatType": "chatter" },
  { "id": "social_chat_2", "stageId": 6, "classType": "commoner", "text": "昨晚集体看了场电影，《列宁在十月》，真带劲！", "glossaryId": "", "chatType": "chatter" },
  { "id": "social_chat_3", "stageId": 6, "classType": "worker", "text": "今年的生产任务我们车间提前完成了。", "glossaryId": "", "chatType": "chatter" },
  { "id": "social_chat_4", "stageId": 6, "classType": "commoner", "text": "孩子放学回来，今天又得了一朵小红花。", "glossaryId": "", "chatType": "chatter" },
  { "id": "social_chat_5", "stageId": 6, "classType": "commoner", "text": "周末去文化宫跳舞，你要不要一起？", "glossaryId": "", "chatType": "chatter" },
  { "id": "social_chat_6", "stageId": 6, "classType": "commoner", "text": "你看那台新拖拉机，比老的好用多了！", "glossaryId": "", "chatType": "chatter" },
  { "id": "social_quirky_1", "stageId": 6, "classType": "commoner", "text": "昨晚梦见马克思了——他坐在拖拉机上，对我竖大拇指说'小伙子干得不错'。", "glossaryId": "", "chatType": "quirky" },
  { "id": "social_quirky_2", "stageId": 6, "classType": "commoner", "text": "我总觉得食堂的馒头认识我——每次我去，那个最大的馒头就自己滚到我盘子里。", "glossaryId": "", "chatType": "quirky" },
  { "id": "social_quirky_3", "stageId": 6, "classType": "worker", "text": "这台机器昨天自己停了，我说'你不工作我们就完不成计划了'，它居然又转起来了！", "glossaryId": "", "chatType": "quirky" },

  { "id": "comm_resident_1", "stageId": 7, "classType": "commoner", "text": "我上午编程，下午画画。", "glossaryId": "human_development", "chatType": "educational" },
  { "id": "comm_resident_2", "stageId": 7, "classType": "commoner", "text": "需要什么就拿，仓库总满着。", "glossaryId": "distribution_need", "chatType": "educational" },
  { "id": "comm_resident_3", "stageId": 7, "classType": "commoner", "text": "没有老板，没有剥削，真好。", "glossaryId": "communism", "chatType": "educational" },
  { "id": "comm_child_1", "stageId": 7, "classType": "commoner", "text": "我想学什么就学什么！", "glossaryId": "human_development", "chatType": "educational" },
  { "id": "comm_artist_1", "stageId": 7, "classType": "commoner", "text": "艺术不再是商品，创作是自由的。", "glossaryId": "freedom", "chatType": "educational" },
  { "id": "comm_scientist_1", "stageId": 7, "classType": "commoner", "text": "全世界的科学家共享研究成果。", "glossaryId": "realm_freedom_necessity", "chatType": "educational" },
  { "id": "comm_elder_1", "stageId": 7, "classType": "commoner", "text": "我活了这么久，从没见过这么美好的世界。", "glossaryId": "communism", "chatType": "educational" },
  { "id": "comm_philosopher_1", "stageId": 7, "classType": "commoner", "text": "回头看：公→私→公——这就是否定之否定，我们回到了更高的起点。", "glossaryId": "negation_of_negation", "chatType": "educational" },
  { "id": "comm_thinker_1", "stageId": 7, "classType": "commoner", "text": "在旧社会你是什么人就定死了——在这儿你可以成为任何人。", "glossaryId": "human_essence", "chatType": "educational" },
  { "id": "comm_leap1_1", "stageId": 7, "classType": "commoner", "text": "我年轻时只觉得'不公平'——只是一种感觉。后来读了书才明白：这不叫'不公平'，这叫'剥削'——把感觉变成道理，就是认识的第一次跳跃。", "glossaryId": "perceptual_to_rational_leap", "chatType": "educational" },
  { "id": "comm_leap2_1", "stageId": 7, "classType": "commoner", "text": "光想明白没用——你得把它变成做的。我们不光想通了要自由，还亲手建了自由——道理变行动，才是真懂。", "glossaryId": "rational_to_practice_leap", "chatType": "educational" },
  { "id": "comm_necessity_1", "stageId": 7, "classType": "commoner", "text": "有人说共产一定会来——也对。可哪一天来、谁领头来、用什么办法来——这些没法算死。必然走的路，脚步各有不同。", "glossaryId": "necessity_contingency", "chatType": "educational" },
  { "id": "comm_chat_1", "stageId": 7, "classType": "commoner", "text": "今天天气真好，去公园看书吧！", "glossaryId": "", "chatType": "chatter" },
  { "id": "comm_chat_2", "stageId": 7, "classType": "commoner", "text": "你听说了吗？昨天有人发明了一个自动做菜机器人。", "glossaryId": "", "chatType": "chatter" },
  { "id": "comm_chat_3", "stageId": 7, "classType": "commoner", "text": "我最近在学弹吉他，进步还挺快的。", "glossaryId": "", "chatType": "chatter" },
  { "id": "comm_chat_4", "stageId": 7, "classType": "commoner", "text": "你觉得幸福的本质是什么呢？", "glossaryId": "", "chatType": "chatter" },
  { "id": "comm_chat_5", "stageId": 7, "classType": "commoner", "text": "下午一起去打球不？好久没动了。", "glossaryId": "", "chatType": "chatter" },
  { "id": "comm_chat_6", "stageId": 7, "classType": "commoner", "text": "昨晚看了一本特别好的小说，推荐给你。", "glossaryId": "", "chatType": "chatter" },
  { "id": "comm_quirky_1", "stageId": 7, "classType": "commoner", "text": "我养的那盆花今天早上对我说'早上好'——真的，它叶子动了三下，那节奏分明就是在说早上好。", "glossaryId": "", "chatType": "quirky" },
  { "id": "comm_quirky_2", "stageId": 7, "classType": "commoner", "text": "你有没有觉得，这个完美的世界太完美了——完美到我怀疑自己是不是在一个模拟器里。", "glossaryId": "", "chatType": "quirky" },
  { "id": "comm_quirky_3", "stageId": 7, "classType": "commoner", "text": "昨天下棋，我赢了机器人——它说它故意输的，想让我开心。我觉得它是在安慰我。", "glossaryId": "", "chatType": "quirky" },

  { "id": "bldg_cave_1", "stageId": 0, "classType": "building", "text": "我是最早的居所。风雨来了，所有人都往我怀里躲——大王和猎人挤在一起，没有谁比谁靠火更近。", "glossaryId": "primitive_community", "chatType": "educational" },
  { "id": "bldg_campfire_1", "stageId": 0, "classType": "building", "text": "我是火。人类第一次控制了我——我不再是野兽，我成了工具。从怕我到用我，这是人第一次超越自然。", "glossaryId": "productive_forces", "chatType": "educational" },
  { "id": "bldg_hut_1", "stageId": 0, "classType": "building", "text": "我是一座集体住所。没有锁，因为不需要——这里的一切都是所有人的。私有是后来的事。", "glossaryId": "public_ownership", "chatType": "educational" },

  { "id": "bldg_fence_1", "stageId": 1, "classType": "building", "text": "我是围栏。木头很简单，但想法不简单——'这是我的，那不是你的'，这句话就是从我开始讲起的。", "glossaryId": "private_property", "chatType": "educational" },
  { "id": "bldg_barn_1", "stageId": 1, "classType": "building", "text": "我是谷仓。以前粮食堆在空地大家分，现在锁在我肚子里——多出来那部分叫'剩余'，但谁拿得多？", "glossaryId": "surplus_product", "chatType": "educational" },

  { "id": "bldg_temple_1", "stageId": 2, "classType": "building", "text": "我是神庙。我的话从不说'抢'和'打'——我只说'命'和'天'。可你仔细听：我说该谁管谁的时候，声音跟主人一模一样。", "glossaryId": "ideology", "chatType": "educational" },
  { "id": "bldg_palace_1", "stageId": 2, "classType": "building", "text": "我是宫殿。我的每一块石头都是一个奴隶的命。你以为我在炫耀好看？我是在告诉所有人——权力住这儿。", "glossaryId": "state_origin", "chatType": "educational" },
  { "id": "bldg_slave_camp_1", "stageId": 2, "classType": "building", "text": "我是奴隶营。关在里面的人不算人——法律说他们只是'会说话的工具'。可他们会哭，会想家，会在梦里喊妈妈。", "glossaryId": "slavery", "chatType": "educational" },

  { "id": "bldg_church_1", "stageId": 3, "classType": "building", "text": "我是教堂。我的钟声每天响，不只在报时——在说：今世的苦是考验，忍了，来世才有福。可为什么总是穷人忍、富人不用忍？", "glossaryId": "ideology", "chatType": "educational" },
  { "id": "bldg_castle_1", "stageId": 3, "classType": "building", "text": "我是城堡。我的墙很高，不止防敌人——防的是下面那些种地的人。地是领主的，水是领主的，连你住的这间屋也是领主的。", "glossaryId": "feudalism", "chatType": "educational" },
  { "id": "bldg_manor_1", "stageId": 3, "classType": "building", "text": "我是庄园。交租的时候农奴弯着腰进来，出去时腰更弯了——他们以为是自己力气不够，其实是制度在吸他们的血。", "glossaryId": "serfdom", "chatType": "educational" },

  { "id": "bldg_factory_1", "stageId": 4, "classType": "building", "text": "我是工厂。我的烟囱日夜冒烟——烟是生产力的味道，也是工人肺里的灰。机器越来越快，人越来越瘦。", "glossaryId": "productive_forces", "chatType": "educational" },
  { "id": "bldg_parliament_1", "stageId": 4, "classType": "building", "text": "我是议会。门口写着'自由、平等、博爱'——可你看里面坐着的人：十个有八个是老板。法律是他们写的，写的是保护他们自己。", "glossaryId": "base_and_superstructure", "chatType": "educational" },
  { "id": "bldg_slum_1", "stageId": 4, "classType": "building", "text": "我是贫民窟。工厂的烟囱在那边冒烟，我的墙这边在掉皮。工人早上走进去，晚上爬回来——机器转得越快，我们住得越破。", "glossaryId": "alienation", "chatType": "educational" },
  { "id": "bldg_bank_1", "stageId": 4, "classType": "building", "text": "我是银行。钱放在我这儿，我只是收着——可奇怪，放钱的人还是穷，借钱开工厂的人越来越富。钱自己不会生钱，是人让它生的。", "glossaryId": "capital_accumulation", "chatType": "educational" },
  { "id": "bldg_market_1", "stageId": 4, "classType": "building", "text": "我是市场。粮食和布，肉和酒——在我这儿它们叫'商品'。但你知道吗？劳动者的力气也在我这儿被标了价——那个价从来不够他吃饱。", "glossaryId": "commodity_fetishism", "chatType": "educational" },

  { "id": "bldg_skyscraper_1", "stageId": 5, "classType": "building", "text": "我是摩天大楼。你抬头看我，觉得高到天上去了——可我的地基打在下水道边上，旁边就是连屋顶都漏雨的贫民区。高和低的距离，就是利润和工资的距离。", "glossaryId": "monopoly", "chatType": "educational" },
  { "id": "bldg_barricade_1", "stageId": 5, "classType": "building", "text": "我是街垒。世界各地的工人在我后面站在一起——不是要加几块钱工资，是在问：凭什么你们说了算？", "glossaryId": "class_struggle", "chatType": "educational" },
  { "id": "bldg_bank_tower_1", "stageId": 5, "classType": "building", "text": "我是银行大厦。我的金库里不只有金子——有油田的契约、铁路的股票、政客的借条。钱早就不是钱了，是权力。", "glossaryId": "monopoly", "chatType": "educational" },
  { "id": "bldg_police_1", "stageId": 5, "classType": "building", "text": "我是警察局。有人说我保护所有人——可你算算：抓小偷我很快，抓偷税的大老板呢？法律这把尺子，量穷人用厘米，量富人用公里。", "glossaryId": "state_monopoly_capitalism", "chatType": "educational" },

  { "id": "bldg_collective_farm_1", "stageId": 6, "classType": "building", "text": "我是集体农场。地是大家的，收成是大家的——没人再拿地租吸你的血。拖拉机一响，比一百头牛都有劲。", "glossaryId": "public_ownership", "chatType": "educational" },
  { "id": "bldg_culture_palace_1", "stageId": 6, "classType": "building", "text": "我是文化宫。以前只有贵族能看书、听音乐——现在大门对所有人敞开。精神生活不再是奢侈品。", "glossaryId": "human_development", "chatType": "educational" },
  { "id": "bldg_hospital_1", "stageId": 6, "classType": "building", "text": "我是医院。以前生了病，有钱的吃药、没钱的等死。现在不管你是厂长还是清洁工——药是一样的，命也是一样的。", "glossaryId": "social_security", "chatType": "educational" },
  { "id": "bldg_school_1", "stageId": 6, "classType": "building", "text": "我是学校。以前读书是富人孩子的特权。现在每一个眼神亮晶晶的小孩都能走进来——知识不再是用来分人的墙。", "glossaryId": "human_development", "chatType": "educational" },

  { "id": "bldg_green_energy_1", "stageId": 7, "classType": "building", "text": "我是绿色能源站。风在转，太阳在照——我们不再靠烧和挖来获取能量。不是自然在供养人，是人学会了跟自然一起呼吸。", "glossaryId": "realm_freedom_necessity", "chatType": "educational" },
  { "id": "bldg_auto_factory_1", "stageId": 7, "classType": "building", "text": "我是自动化工厂。机器做机器的事，人做人的事——创作、思考、享受。劳动不再是枷锁，是自由自觉的活动。", "glossaryId": "human_development", "chatType": "educational" },
  { "id": "bldg_leisure_center_1", "stageId": 7, "classType": "building", "text": "我是休闲中心。人终于不用把所有时间都用来挣饭吃。上午编程，下午画画——自由不是躺在家里，是想成为什么就能成为什么。", "glossaryId": "freedom", "chatType": "educational" }
]